# Copy to .env and fill in for production use. All of these can also be set
# from the Settings panel in the admin dashboard (Settings > Payment / General) —
# env vars here are optional overrides useful for deployment.

PORT=4790
SESSION_SECRET=change-me-to-a-long-random-string

# Shopify Admin API (optional — falls back to a labeled mock checkout if unset)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
