# Copy to .env and fill in for production use. All of these can also be set
# from the Settings panel in the admin dashboard (Settings > Payment / General) —
# env vars here are optional overrides useful for deployment.

PORT=4790
SESSION_SECRET=change-me-to-a-long-random-string

# Where the database, uploaded artwork and email copies are stored. On Render
# this must point at the persistent disk (mounted at /data), or everything is
# wiped on each deploy. Leave unset locally to use the repo's data/ folder.
# DATA_DIR=/data

# Shopify (optional; falls back to a labeled mock checkout if unset). Uses a
# Dev Dashboard app's client ID + secret (client-credentials grant), see
# server/services/paymentService.js.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
